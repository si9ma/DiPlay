    <string name="settings_battery_card_show">Mostrar la tarjeta de batería</string>
    <string name="settings_battery_card_show_description">Muestra carga, potencia, temperaturas y otros datos de la batería sobre otras apps. Necesita permiso para mostrarse sobre otras apps y el acceso ADB de DiPlay; funciona sin CarPlay.</string>
